<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) data extraction rules.
     We disable all auto backup / device-to-device transfer so Hive boxes
     holding bike + service + fuel data stay inside the app sandbox. Any
     sync happens explicitly through Firestore while signed in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
